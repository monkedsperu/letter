# Copia este archivo como  .env  y cambia TODOS los valores antes de subirlo a AWS.

# Usuario administrador (se crea/actualiza solo en cada arranque)
ADMIN_USUARIO=admin
ADMIN_CLAVE=admin12345

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Ponlo en 1 cuando el sitio esté detrás de HTTPS (recomendado en AWS)
COOKIES_SEGURAS=0

# Dónde guardar la base de datos (opcional; por defecto monkeds.db junto a app.py)
# MONKEDS_DB=/var/lib/monkeds/monkeds.db

# Solo para el arranque local con "python app.py"
HOST=127.0.0.1
PORT=8000
